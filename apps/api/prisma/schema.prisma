// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  REGULATEUR
  AMBULANCIER
  COMPTABLE
  PATIENT
  CLINIQUE
  PARTENAIRE
}

enum MissionStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  TRANSPORTING
  COMPLETED
  VALIDATED
  CANCELLED
}

enum VehicleStatus {
  AVAILABLE
  ON_MISSION
  MAINTENANCE
  OUT_OF_SERVICE
}

enum DocumentType {
  MEDICAL_REPORT
  PRESCRIPTION
  INVOICE
  IDENTITY
  CONSENT
  OTHER
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

enum NotificationType {
  MISSION_ASSIGNED
  MISSION_STATUS_CHANGED
  DOCUMENT_SHARED
  PAYMENT_RECEIVED
  SYSTEM
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  siret     String?  @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?

  users         User[]
  patients      Patient[]
  vehicles      Vehicle[]
  missions      Mission[]
  invoices      Invoice[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole  @default(AMBULANCIER)
  isActive       Boolean   @default(true)
  refreshToken   String?
  lastLoginAt    DateTime?
  phone          String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  crewMembers   CrewMember[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Patient {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  birthDate      DateTime?
  gender         String?
  address        String?
  phone          String?
  email          String?
  socialNumber   String?
  isActive       Boolean   @default(true)
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  missions      Mission[]
  documents     Document[]
  prescriptions Prescription[]
  mutuelles     Mutuelle[]
  invoices      Invoice[]
}

model Vehicle {
  id             String        @id @default(cuid())
  plate          String        @unique
  model          String
  type           String
  status         VehicleStatus @default(AVAILABLE)
  metadata       Json?
  isActive       Boolean       @default(true)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  crews        Crew[]
  gpsTracks    GpsTrack[]
}

model Crew {
  id        String   @id @default(cuid())
  name      String
  vehicleId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle  Vehicle      @relation(fields: [vehicleId], references: [id])
  members  CrewMember[]
  missions Mission[]
}

model CrewMember {
  id        String   @id @default(cuid())
  crewId    String
  userId    String
  role      String
  createdAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Mission {
  id             String        @id @default(cuid())
  status         MissionStatus @default(PENDING)
  priority       Int           @default(1)
  address        String?
  notes          String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  patientId      String?
  crewId         String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  patient      Patient?       @relation(fields: [patientId], references: [id])
  crew         Crew?          @relation(fields: [crewId], references: [id])
  events       MissionEvent[]
  documents    Document[]
  invoices     Invoice[]
}

model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  type      String
  data      Json?
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id])
}

model GpsTrack {
  id        String   @id @default(cuid())
  vehicleId String
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model Document {
  id          String       @id @default(cuid())
  filename    String
  url         String
  mimeType    String?
  sizeBytes   Int?
  type        DocumentType @default(OTHER)
  isEncrypted Boolean      @default(true)
  patientId   String?
  missionId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  patient Patient? @relation(fields: [patientId], references: [id])
  mission Mission? @relation(fields: [missionId], references: [id])
}

model Prescription {
  id         String    @id @default(cuid())
  medication String
  dosage     String?
  frequency  String?
  startDate  DateTime?
  endDate    DateTime?
  doctorName String?
  notes      String?
  isActive   Boolean   @default(true)
  patientId  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  status         InvoiceStatus @default(DRAFT)
  amount         Float
  vatRate        Float         @default(0)
  dueDate        DateTime?
  paidAt         DateTime?
  notes          String?
  missionId      String?
  patientId      String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  mission      Mission?      @relation(fields: [missionId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  lines        InvoiceLine[]
}

model InvoiceLine {
  id          String   @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  invoiceId   String
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Mutuelle {
  id        String    @id @default(cuid())
  name      String
  number    String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  patientId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
}

model Notification {
  id             String           @id @default(cuid())
  type           NotificationType @default(SYSTEM)
  title          String
  message        String
  isRead         Boolean          @default(false)
  data           Json?
  userId         String
  organizationId String
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entity         String
  entityId       String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  userId         String?
  organizationId String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
}
